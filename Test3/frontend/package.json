    "test:e2e:types": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@dagrejs/dagre": "^3.1.3",
    "@tanstack/react-query": "^5.62.8",
