# 阿里云百炼（DashScope）OpenAI 兼容接口密钥。只放本机，不要提交。
DASHSCOPE_API_KEY=

# 反馈作者标识 HMAC 密钥。未设置时监听流水线拒绝导入。
FEEDBACK_HASH_KEY=

# 可选：覆盖默认数据目录（默认 Test3/data）
# TEST3_DATA_DIR=

# 可选：是否让 HTTP 客户端读取 shell 里的 http(s)_proxy / all_proxy（默认 0，直连）。
# 若 shell 里是 all_proxy=socks5h://… 而没装 httpx[socks]，读取代理会在发请求前直接报错。
# TEST3_HTTP_TRUST_ENV=0

# 可选：LLM 提供者 dashscope | replay | scripted（进程默认 scripted，避免空密钥误打百炼）
# TEST3_LLM_PROVIDER=scripted
# scripted 时默认灌入自习室 M1 队列；留空则队列为空
# TEST3_SCRIPTED_FIXTURE=study-room
